#!/usr/bin/env bash
#
# git post-receive hook — lets you deploy with `git push production master`.
#
# Companion to deploy.sh: that script does the one-time server provisioning
# (systemd unit "whitelabel-api", Nginx, ufw, Postgres/Redis). This hook re-runs
# the "update" subset of those steps (install, migrate, build, restart) every
# time a push lands on the bare repo below.
#
# ── One-time server setup (whitelabel-api.yativo.com / whitelabel.yativo.com) ─
#
# The codebase already lives at /opt/yativo-white-label — deploy.sh has run
# there before (apps/ is owned by the whitelabel service user). This hook
# reuses that directory as WORK_TREE; it does NOT clone anywhere new.
#
#   1. If deploy.sh hasn't fully finished on this box yet (no whitelabel-api
#      systemd service, no Nginx config for these two domains), run it once
#      more from the existing directory — it's idempotent, safe to re-run:
#        cd /opt/yativo-white-label
#        ./deploy.sh whitelabel-api.yativo.com whitelabel.yativo.com emma@yativo.com
#
#   2. Create a bare repo to push to, separate from the working tree above:
#        git init --bare /root/white-label.git
#
#   3. Install this file as its post-receive hook:
#        cp /opt/yativo-white-label/post-receive /root/white-label.git/hooks/post-receive
#        chmod +x /root/white-label.git/hooks/post-receive
#
#   4. On your machine:
#        git remote add production root@whitelabel-api.yativo.com:/root/white-label.git
#        git push production master
#
# Pushing as root (matching how deploy.sh itself must run) means no sudoers
# setup is needed for the systemctl/nginx calls below. If you'd rather push as
# a non-root deploy user, switch to that user, chown WORK_TREE to it, and add:
#   <user> ALL=(root) NOPASSWD: /usr/bin/systemctl restart whitelabel-api, /usr/bin/systemctl reload nginx
#
# Every step below is the same idempotent pattern as deploy.sh, so a push that
# fails partway through is safe to just fix and push again.

set -euo pipefail

WORK_TREE="/opt/yativo-white-label"   # <-- the existing deployed codebase
DEPLOY_BRANCH="master"
SERVICE_NAME="whitelabel-api"
LOG_FILE="$HOME/deploy.log"

exec > >(tee -a "$LOG_FILE") 2>&1
echo "=== post-receive: $(date -u +%FT%TZ) ==="

while read -r _oldrev newrev refname; do
  branch="${refname##*/}"
  if [ "$branch" != "$DEPLOY_BRANCH" ]; then
    echo "Push to '$branch' ignored — only '$DEPLOY_BRANCH' deploys."
    continue
  fi

  if [ ! -d "$WORK_TREE" ]; then
    echo "==> $WORK_TREE doesn't exist yet — creating it"
    mkdir -p "$WORK_TREE"
  fi

  echo "==> Checking out $newrev into $WORK_TREE"
  GIT_WORK_TREE="$WORK_TREE" GIT_DIR="$(pwd)" git checkout -f "$branch"

  cd "$WORK_TREE"

  if [ ! -f apps/api/.env ] || [ ! -f apps/web/.env.production ]; then
    echo "!!  apps/api/.env or apps/web/.env.production is missing."
    echo "!!  This looks like a first-ever deploy to this box — run deploy.sh once"
    echo "!!  first (it generates these with fresh secrets) or copy them over"
    echo "!!  manually, then push again."
    continue
  fi

  echo "==> Installing dependencies"
  pnpm install --frozen-lockfile

  echo "==> Running Prisma migrations"
  pnpm --filter api exec prisma generate
  pnpm --filter api exec prisma migrate deploy

  echo "==> Building API"
  pnpm --filter api build

  echo "==> Building web app"
  pnpm --filter web build

  if systemctl list-unit-files "${SERVICE_NAME}.service" >/dev/null 2>&1; then
    echo "==> Restarting $SERVICE_NAME"
    sudo systemctl restart "$SERVICE_NAME"
  else
    echo "!!  systemd service '$SERVICE_NAME' doesn't exist yet — skipping restart."
    echo "!!  Run deploy.sh once to create it, then push again."
  fi

  if command -v nginx >/dev/null 2>&1; then
    echo "==> Reloading Nginx"
    sudo nginx -t
    sudo systemctl reload nginx
  else
    echo "!!  Nginx isn't installed yet — skipping reload. Run deploy.sh to set it up."
  fi

  echo "=== Deploy of $newrev complete: $(date -u +%FT%TZ) ==="
done
