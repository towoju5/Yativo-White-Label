    "@fastify/rate-limit": "^10.1.1",
    "@prisma/client": "^5.20.0",
    "@simplewebauthn/server": "^13.3.2",
    "@white-label/shared-types": "workspace:*",
    "@white-label/yativo-sdk": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.28.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
