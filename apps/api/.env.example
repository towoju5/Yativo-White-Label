NODE_ENV=development
PORT=9000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/whitelabel
REDIS_URL=redis://localhost:6380

# Staff (admin) auth
JWT_ACCESS_SECRET=change-me-staff-access-secret
JWT_REFRESH_SECRET=change-me-staff-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Customer (portal) auth — kept separate so a portal token can never be used on admin routes
PORTAL_JWT_ACCESS_SECRET=change-me-portal-access-secret
PORTAL_JWT_REFRESH_SECRET=change-me-portal-refresh-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-openssl-rand--hex-32
PORTAL_JWT_ACCESS_TTL=15m
PORTAL_JWT_REFRESH_TTL=30d

# Yativo — mock | sandbox | live
# Auth is via X-Api-Key / X-Api-Secret headers on every request (see packages/yativo-sdk/src/client.ts).
YATIVO_MODE=mock
YATIVO_FIAT_BASE_URL=https://api.yativo.com/api/v1
YATIVO_KYC_BASE_URL=https://kyc.yativo.com
YATIVO_API_KEY=
YATIVO_API_SECRET=
YATIVO_WEBHOOK_SECRET=change-me-webhook-secret

APP_BASE_URL=http://localhost:9000
WEB_APP_URL=http://localhost:5173
LOG_LEVEL=info

# Local-disk asset storage — leave unset to use the default directory inside the API app.
STORAGE_LOCAL_DIR=

# Signs the statement-verification QR token — generate with `openssl rand -hex 32`.
STATEMENT_VERIFY_SECRET=change-me-statement-verify-secret

# Transactional email. EMAIL_MODE=sendmail (default) pipes through the local sendmail-compatible
# binary — no credentials needed, works if postfix/sendmail is installed on this host. Set
# EMAIL_MODE=smtp to relay via the SMTP_* settings instead. All of this can also be set/overridden
# later from the admin UI under Settings → Integrations.
EMAIL_MODE=sendmail
SENDMAIL_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@example.com
